# The settings of the product with local values, for docker compose. Copy this
# file to .env, which git ignores. In a stamp, the platform sets the same names
# (docs/configuration.md). Never put a real password or key here.

# The local Postgres container.
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app

# Set by the stamp; dev, test or prod there.
PLATFORM_ENVIRONMENT=local

# Read by api and migrator. In a stamp, the stamp's postgres service sets it.
DATABASE_URL=postgresql://app:app@postgres:5432/app

# Object storage. In a stamp, the stamp's storage service sets them. The public
# endpoint is the dashboard's address: presigned URLs go through its /storage.
S3_ENDPOINT=http://storage:9000
S3_PUBLIC_ENDPOINT=http://localhost:8082
S3_BUCKET=storage
S3_ACCESS_KEY=storage-local
S3_SECRET_KEY=storage-local-secret

# Not set here, as in a dev stamp: REDIS_URL (the API uses its in-memory cache),
# MESSAGING_URL (in-memory events, the outbox in Postgres), SMTP_PASSWORD (mail
# is off).

# Secrets. In a stamp, an engineer sets them in the Key Vault.
JWT_SIGNING_KEY=local-only-jwt-signing-key-at-least-32-characters
HANGFIRE_PASSWORD=local-hangfire-password
SEED_ADMIN_PASSWORD=Local-admin-123!

# Seeds the demo tenants acme and globex, whose accounts share the public
# password Password123!, and shows the demo sign-in on the dashboard. Never in
# an Environment with real data.
SEED_DEMO=true

# Settings that reach the browser through /config.json. Every setting whose
# name starts with PUBLIC_ does; never put a secret in one.
PUBLIC_DASHBOARD_URL=http://localhost:8082
